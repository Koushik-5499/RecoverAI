# Environment variables for RecoverAI backend

# Application
APP_ENV=development
MOCK_MODE=True

# Database (Use sqlite for local MVP if not provided)
# DATABASE_URL=postgresql://user:password@localhost:5432/recoverai
DATABASE_URL=sqlite:///./recoverai.db

# Security
SECRET_KEY=your-super-secret-key-change-me

# Razorpay Integration (Keep empty to trigger mock mode if MOCK_MODE=False)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini Integration (Keep empty to trigger mock mode)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
